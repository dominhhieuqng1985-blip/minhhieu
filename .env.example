# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VIDKRAKEN_API_KEY: Optional override for VidKraken API v2 downloads (default key provided)
VIDKRAKEN_API_KEY="YOUR_VIDKRAKEN_API_KEY"

# Optional Google OAuth 2.0 Client ID for 100% server-verified YouTube subscription check (youtube.readonly)
GOOGLE_CLIENT_ID=""
VITE_GOOGLE_CLIENT_ID=""

# Neon Serverless PostgreSQL connection string for Admin Auth, Settings & Study Data persistence
DATABASE_URL=""
NEON_DATABASE_URL=""

# HilltopAds Publisher API Key for Ad Management, Live Balance & Stats
HILLTOPADS_API_KEY="XOxIVWkMqKGQUcaHf3CGzhCYAizN2oSnzrgcYPBzho9JvQUqoYY1cTqFToARZvfe"
